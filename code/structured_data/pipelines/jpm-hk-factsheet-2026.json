{
  "pipeline_version": 1,
  "layout_id": "jpm-hk-factsheet-2026",
  "detect": {
    "all": ["基金資料", "總資產值"],
    "any": ["SICAV系列", "摩根基金", "摩根"],
    "min_hits": 2
  },
  "fields": {
    "fund_size": {"rule_id": "jpm_header_size_v1", "stage": "deterministic", "parser": "fund_size", "labels": ["總資產值（百萬）", "總資產值(百萬)", "基金規模"], "fallback": ["native_text", "vision_header", "model_slice"]},
    "report_date": {"rule_id": "jpm_report_month_v1", "stage": "deterministic", "parser": "report_month", "labels": ["截至", "資料截至", "As of", "Data as at"], "fallback": ["month_hint", "model_slice"]},
    "portfolio_duration_years": {"rule_id": "jpm_duration_v1", "stage": "deterministic", "parser": "duration", "labels": ["平均存續期", "組合久期", "Duration"], "fallback": ["model_slice", "vision_table"]},
    "portfolio_ytm_percent": {"rule_id": "jpm_ytm_v1", "stage": "deterministic", "parser": "ytm", "labels": ["到期收益率", "期滿收益率", "期满收益率", "平均到期孳息率", "Yield to maturity", "YTM"], "fallback": ["model_slice", "vision_table"]},
    "credit_rating": {"rule_id": "jpm_credit_rating_v1", "stage": "deterministic", "parser": "credit_rating", "fallback": ["model_slice", "vision_table"]}
  }
}
